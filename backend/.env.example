# ---- Google OAuth (Google Cloud Console -> APIs & Services -> Credentials) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match "Authorized redirect URI" in Google Console EXACTLY
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---- LinkedIn (Sign In with LinkedIn using OpenID Connect) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match the LinkedIn Developer Portal redirect URL
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# ---- Discord account link (OAuth2 identify only; no server/message access) ----
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match the redirect registered in Discord Developer Portal
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# ---- Gemini (https://aistudio.google.com/apikey) ----
# Empty chhodoge to rule-based extractor chalega (app phir bhi kaam karega)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# First Gmail connection imports up to this many received messages per sync,
# then resumes the history cursor until the bounded lookback is complete.
GMAIL_INITIAL_SYNC_MAX_EMAILS=500
GMAIL_INITIAL_SYNC_DAYS=0
# 0 means no date limit (all received mail except Sent, Spam, and Trash).

# ---- Optional local LLM (Ollama Qwen or llama.cpp GGUF) ----
LOCAL_LLM_ENABLED=false
# disabled | local-first | local-only
LOCAL_LLM_MODE=disabled
# llama.cpp (bundled GGUF) or ollama (recommended simple local runtime)
LOCAL_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=5m
LOCAL_LLM_MODEL_PATH=./models/qwen3-0.6b-instruct-q4_k_m.gguf
LOCAL_LLM_CONTEXT=4096
LOCAL_LLM_THREADS=3
LOCAL_LLM_BATCH=128
LOCAL_LLM_MAX_TOKENS=256
# In local-first mode, Gemini is used only when local inference is unavailable.
ASSISTANT_CLOUD_FALLBACK=true

# ---- App ----
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000
# Comma-separated browser origins trusted for direct API access. Keep the
# OAuth callback and FRONTEND_URL on one origin per login flow.
FRONTEND_ORIGINS=http://localhost:3000
TIMEZONE=Asia/Kolkata
DATABASE_URL=sqlite:///./nexus.db
# true = "Try Demo" button on login page (fake Gmail/Calendar data, no Google needed)
DEMO_MODE=true

# PostgreSQL (for local infrastructure): postgresql+psycopg://nexus:nexus-local-only@localhost:5432/nexus
